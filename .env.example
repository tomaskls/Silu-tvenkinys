# Nukopijuokite į .env ir užpildykite

# Duomenų bazė (Neon PostgreSQL: vercel env pull)
DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Viešas svetainės adresas (reikalingas Montonio grąžinimo ir webhook adresams)
SITE_URL="http://localhost:3000"

# Administratoriaus puslapis /admin
ADMIN_USER="admin"
ADMIN_PASSWORD="pakeiskite-slaptazodi"

# Montonio (https://partners.montonio.com → API raktai).
# Kol tušti – naudojamas testinis mokėjimas (tik kūrimo aplinkoje).
MONTONIO_ACCESS_KEY=""
MONTONIO_SECRET_KEY=""
# "sandbox" arba "production"
MONTONIO_ENV="sandbox"

# Leisti testinius mokėjimus produkcijoje (NENAUDOKITE tikroje svetainėje)
ALLOW_MOCK_PAYMENTS="false"
