// Duomenų bazės schema (PostgreSQL – Neon per Vercel).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Tiesioginė jungtis (be pool) – naudojama db push / migracijoms
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Sector {
  id           Int           @id @default(autoincrement())
  number       Int           @unique
  name         String
  description  String        @default("")
  image        String?
  // Kaina už vieną parą, centais (2500 = 25,00 €)
  pricePerDay  Int
  maxAnglers   Int           @default(2)
  active       Boolean       @default(true)
  reservations Reservation[]
}

// Rezervacijas (priimtas telefonu) įveda administratorius. Kiekvienas įrašas užima sektorių nurodytomis dienomis.
model Reservation {
  id            String   @id @default(cuid())
  sector        Sector   @relation(fields: [sectorId], references: [id])
  sectorId      Int
  // Datos saugomos kaip "YYYY-MM-DD" – tokias eilutes galima lyginti leksikografiškai.
  // dateFrom – atvykimo diena, dateTo – išvykimo diena (neįskaičiuota į užimtumą).
  dateFrom      String
  dateTo        String
  // Kliento duomenys matomi tik administratoriui (neprivalomi)
  customerName  String   @default("")
  customerPhone String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sectorId, dateFrom, dateTo])
}

model Competition {
  id          Int      @id @default(autoincrement())
  title       String
  date        String
  endDate     String?
  description String
  entryFee    Int?
  maxTeams    Int?
  image       String?
  // Rezultatai po varžybų (laisvas tekstas)
  results     String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model CatchPhoto {
  id          Int      @id @default(autoincrement())
  image       String
  angler      String
  species     String
  weightKg    Float?
  // Rodomas vietoj weightKg, kai svoris netikslus („15+ kg“) ar žuvys kelios
  weightLabel String?
  sector      Int?
  date        String
  caption     String   @default("")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}
